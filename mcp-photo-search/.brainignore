# Photo Search MCP - Ignore Patterns
# Focus on indexing photo metadata JSON files in /photos

# === MEDIA FILES (we want metadata, not the actual images/videos) ===
*.jpg
*.jpeg
*.png
*.gif
*.heic
*.HEIC
*.bmp
*.tiff
*.webp
*.mp4
*.mov
*.avi
*.mkv
*.raw
*.dng

# === KEEP METADATA FILES ===
# Don't ignore: *.json (we want these for photo metadata)

# === SYSTEM DIRECTORIES ===
processing/
.temp/
.cache/

# === DUPLICATE DETECTION RESULTS ===
duplicates/
duplicate-*.json
similar-*.json
rotation-*.json

# === OS FILES ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# === BUILD ARTIFACTS ===
node_modules/
dist/
build/
coverage/
*.log

# === DATABASE FILES ===
*.db
*.sqlite
*.sqlite3

# === BACKUP/TEMP FILES ===
*.backup
*.tmp
*.temp
backup/
backups/

# === LARGE DATA DUMPS ===
*.sql
*.csv
*.tsv
all_photos.txt
*batch*.txt

# === VERSION CONTROL ===
.git/