#!/bin/bash

# multicrop-tool/process - A wrapper script for multicrop-ref
# 
# Usage: process -src <input> -dest <output> [options]
#
# Required:
#   -src    input file or directory
#   -dest   output directory (created if doesn't exist)
#
# Optional:
#   -limit  max files to process (directory mode only)
#   -f      fuzz value (default 10)
#   -T      trim amount in pixels (default 6)
#   -M      save mask files with __mask suffix
#   -O      save original files with _original suffix
#   -b      background color (default "white")
#   -R      reference background image file
#   -h      show help

# Default values
src=""
dest=""
limit=""
fuzz=10
trim=6
save_mask=false
save_original=false
background="white"
reference_image=""

# Get script directory and set paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MULTICROP_REF="$SCRIPT_DIR/multicrop-ref"
BACKGROUNDS_DIR="$SCRIPT_DIR/backgrounds"

# Function to show help
show_help() {
    echo "multicrop-tool/process - A wrapper script for multicrop-ref"
    echo ""
    echo "Usage: $0 -src <input> -dest <output> [options]"
    echo ""
    echo "Required:"
    echo "  -src    input file or directory"
    echo "  -dest   output directory (created if doesn't exist)"
    echo ""
    echo "Optional:"
    echo "  -limit  max files to process (directory mode only)"
    echo "  -f      fuzz value (default 10)"
    echo "  -T      trim amount in pixels (default 6)"
    echo "  -M      save mask files with __mask suffix"
    echo "  -O      save original files with _original suffix"
    echo "  -b      background color (default \"white\")"
    echo "  -R      reference background image file (full path)"
    echo "  -r      background shortcut (looks for <name>.jpg in backgrounds/)"
    echo "  -h      show this help"
    echo ""
    echo "Examples:"
    echo "  $0 -src input.jpg -dest output/"
    echo "  $0 -src input_dir/ -dest output/ -limit 5 -M"
    echo "  $0 -src input.jpg -dest output/ -f 15 -T 8"
    echo "  $0 -src input_dir/ -dest output/ -R /path/to/reference.jpg"
    echo "  $0 -src input.jpg -dest output/ -r red    # uses backgrounds/red.jpg"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -src)
            src="$2"
            shift 2
            ;;
        -dest)
            dest="$2"
            shift 2
            ;;
        -limit)
            limit="$2"
            shift 2
            ;;
        -f)
            fuzz="$2"
            shift 2
            ;;
        -T)
            trim="$2"
            shift 2
            ;;
        -M)
            save_mask=true
            shift
            ;;
        -O)
            save_original=true
            shift
            ;;
        -b)
            background="$2"
            reference_image=""  # Clear reference image if background color is set
            shift 2
            ;;
        -R)
            reference_image="$2"
            background=""  # Clear background color if reference image is set
            shift 2
            ;;
        -r)
            # Shortcut for background images - look in backgrounds directory
            bg_name="$2"
            reference_image="$BACKGROUNDS_DIR/$bg_name.jpg"
            background=""  # Clear background color
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            show_help
            exit 1
            ;;
    esac
done

# Check required arguments
if [ -z "$src" ] || [ -z "$dest" ]; then
    echo "Error: Both -src and -dest are required"
    echo ""
    show_help
    exit 1
fi

# Check if source exists
if [ ! -e "$src" ]; then
    echo "Error: Source '$src' does not exist"
    exit 1
fi

# Check if multicrop-ref exists
if [ ! -x "$MULTICROP_REF" ]; then
    echo "Error: multicrop-ref not found at $MULTICROP_REF"
    exit 1
fi

# Check if reference image exists (if specified)
if [ -n "$reference_image" ] && [ ! -f "$reference_image" ]; then
    echo "Error: Reference image not found at $reference_image"
    exit 1
fi

# Create destination directory if it doesn't exist
mkdir -p "$dest"

# Build multicrop-ref arguments
multicrop_args="-f $fuzz -T $trim"

if [ "$save_mask" = true ]; then
    multicrop_args="$multicrop_args -M"
fi

if [ -n "$reference_image" ]; then
    multicrop_args="$multicrop_args -R \"$reference_image\""
elif [ -n "$background" ]; then
    multicrop_args="$multicrop_args -b $background"
fi

echo "multicrop-tool/process starting..."
echo "Source: $src"
echo "Destination: $dest"
echo "Multicrop args: $multicrop_args"

# Function to process a single file
process_single_file() {
    local input_file="$1"
    local output_dir="$2"
    
    # Get filename without path and extension
    local filename=$(basename "$input_file")
    local basename_no_ext
    
    # Remove extension from filename for output base name
    if [[ "$filename" == *.* ]]; then
        basename_no_ext="${filename%.*}"
    else
        basename_no_ext="$filename"
    fi
    
    echo "  Input: $input_file"
    echo "  Output base: $output_dir/$basename_no_ext"
    
    # Build the multicrop-ref command
    local cmd="\"$MULTICROP_REF\" -f $fuzz -T $trim"
    
    if [ "$save_mask" = true ]; then
        cmd="$cmd -M"
    fi
    
    if [ "$save_original" = true ]; then
        cmd="$cmd -O"
    fi
    
    if [ -n "$reference_image" ]; then
        cmd="$cmd -R \"$reference_image\""
    elif [ -n "$background" ]; then
        cmd="$cmd -b $background"
    fi
    
    # Add input and output
    cmd="$cmd \"$input_file\" \"$output_dir/$basename_no_ext.jpg\""
    
    echo "  Command: $cmd"
    echo ""
    
    # Execute the command
    eval $cmd
    
    if [ $? -eq 0 ]; then
        echo "  ✓ Successfully processed $filename"
    else
        echo "  ✗ Failed to process $filename"
        return 1
    fi
}

# Determine if source is file or directory
if [ -f "$src" ]; then
    echo "Processing single file..."
    echo ""
    process_single_file "$src" "$dest"
elif [ -d "$src" ]; then
    echo "Processing directory..."
    echo "Source directory: $src"
    
    # Find all .jpg files in the directory
    jpg_files=()
    while IFS= read -r -d '' file; do
        jpg_files+=("$file")
    done < <(find "$src" -maxdepth 1 -name "*.jpg" -type f -print0 | sort -z)
    
    total_files=${#jpg_files[@]}
    echo "Found $total_files JPG files"
    
    if [ $total_files -eq 0 ]; then
        echo "No JPG files found in directory"
        exit 1
    fi
    
    # Apply limit if specified
    files_to_process=$total_files
    if [ -n "$limit" ] && [ "$limit" -gt 0 ] && [ "$limit" -lt "$total_files" ]; then
        files_to_process=$limit
        echo "Processing first $limit files (limit applied)"
    fi
    
    echo ""
    
    # Process each file
    processed_count=0
    failed_count=0
    
    for ((i=0; i<files_to_process; i++)); do
        file="${jpg_files[i]}"
        echo "[$((i+1))/$files_to_process] Processing $(basename "$file")..."
        
        if process_single_file "$file" "$dest"; then
            ((processed_count++))
        else
            ((failed_count++))
            echo "  Continuing with next file..."
        fi
        echo ""
    done
    
    echo "Directory processing summary:"
    echo "  Files processed successfully: $processed_count"
    echo "  Files failed: $failed_count"
    echo "  Total files processed: $((processed_count + failed_count))"
else
    echo "Error: Source '$src' is neither a file nor a directory"
    exit 1
fi

echo "Processing complete."