# Database Configuration (NEVER commit real passwords!)
DB_HOST=localhost
DB_PORT=3309
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=your_database_name

# Geolocation & Enrichment Providers
GEOLOCATION_ENABLED=true
GNIS_PROVIDER_ENABLED=true
NPS_PROVIDER_ENABLED=true
RECREATION_GOV_PROVIDER_ENABLED=false
LANDMARK_MAX_RADIUS=50000

# Recreation.gov API (required if RECREATION_GOV_PROVIDER_ENABLED=true)
# RECREATION_GOV_API_KEY=your_api_key_here

# Path Configuration
SAMPLE_BASE_PATH=/path/to/your/sample_media
MEDIA_BASE_PATH=/path/to/your/media/files

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=structured
LOG_OUTPUT=console

# Performance Tuning
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT=30000
DB_CREATE_TIMEOUT=30000

# Provider Timeouts (milliseconds)
GEOLOCATION_TIMEOUT=5000
LANDMARK_TIMEOUT=10000
RECREATION_TIMEOUT=15000

# Processor Version
PROCESSOR_VERSION=1.2.0