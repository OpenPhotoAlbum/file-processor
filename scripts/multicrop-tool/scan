#!/bin/bash

# multicrop-tool/scan - Scan images and automatically process them
# 
# Usage: scan -dest <output> [options]
#
# Required:
#   -dest   output directory for processed photos
#
# Optional:
#   -name       description for filename (spaces→dash, commas→__)
#   -scan-dir   directory for original scans (default: dest/scans/)
#   -device     scanner device (default: "airscan:e0:HP")
#   -keep-scan  keep original scan file after processing
#   -date       set photo dates (formats: 1997, 12-1997, 12-01-1997)
#   -r          background shortcut (red, white, etc.)
#   -R          reference background image file (full path)
#   -b          background color (default "white")
#   -M          save mask files
#   -f          fuzz value (default 10)
#   -T          trim amount (default 6)
#   -h          show help

# Default values
dest=""
name=""
scan_dir=""
device="airscan:e0:HP"
keep_scan=false
date_input=""

# Process tool options (pass-through)
background_shortcut=""
reference_image=""
background_color=""
save_mask=false
save_original=false
fuzz=""
trim=""

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROCESS_TOOL="$SCRIPT_DIR/multicrop"
DATE_TOOL="$SCRIPT_DIR/set-photo-dates"

# Function to show help
show_help() {
    echo "multicrop-tool/scan - Scan images and automatically process them"
    echo ""
    echo "Usage: $0 -dest <output> [options]"
    echo ""
    echo "Required:"
    echo "  -dest       output directory for processed photos"
    echo ""
    echo "Optional:"
    echo "  -name       description for filename (spaces→dash, commas→__)"
    echo "  -scan-dir   directory for original scans (default: dest/scans/)"
    echo "  -device     scanner device (default: \"airscan:e0:HP\")"
    echo "  -keep-scan  keep original scan file after processing"
    echo "  -date       set photo dates (formats: 1997, 12-1997, 12-01-1997)"
    echo ""
    echo "Processing options (passed to process tool):"
    echo "  -r          background shortcut (red, white, etc.)"
    echo "  -R          reference background image file (full path)"
    echo "  -b          background color (default \"white\")"
    echo "  -M          save mask files"
    echo "  -O          save original files"
    echo "  -f          fuzz value (default 10)"
    echo "  -T          trim amount (default 6)"
    echo "  -h          show this help"
    echo ""
    echo "Examples:"
    echo "  $0 -dest output/ -r red -name \"family photos, christmas 1985\""
    echo "  $0 -dest scanned/ -M -keep-scan -name \"wedding album page 5\""
    echo "  $0 -dest photos/ -device \"hp:scanner\" -name \"vacation pics\""
    echo "  $0 -dest photos/ -r red -date \"1985-12-25\" -name \"christmas morning\""
}

# Function to clean filename
clean_filename() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/ /-/g' | sed 's/,/__/g' | sed 's/[^a-z0-9_-]//g'
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -dest)
            dest="$2"
            shift 2
            ;;
        -name)
            name="$2"
            shift 2
            ;;
        -scan-dir)
            scan_dir="$2"
            shift 2
            ;;
        -device)
            device="$2"
            shift 2
            ;;
        -keep-scan)
            keep_scan=true
            shift
            ;;
        -date)
            date_input="$2"
            shift 2
            ;;
        -r)
            background_shortcut="$2"
            shift 2
            ;;
        -R)
            reference_image="$2"
            shift 2
            ;;
        -b)
            background_color="$2"
            shift 2
            ;;
        -M)
            save_mask=true
            shift
            ;;
        -O)
            save_original=true
            shift
            ;;
        -f)
            fuzz="$2"
            shift 2
            ;;
        -T)
            trim="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            show_help
            exit 1
            ;;
    esac
done

# Check required arguments
if [ -z "$dest" ]; then
    echo "Error: -dest is required"
    echo ""
    show_help
    exit 1
fi

# Check if scanimage is available
if ! command -v scanimage &> /dev/null; then
    echo "Error: scanimage command not found"
    echo "Please install SANE scanner utilities"
    exit 1
fi

# Check if multicrop tool exists
if [ ! -x "$PROCESS_TOOL" ]; then
    echo "Error: multicrop tool not found at $PROCESS_TOOL"
    exit 1
fi

# Check if date tool exists (if date is specified)
if [ -n "$date_input" ] && [ ! -x "$DATE_TOOL" ]; then
    echo "Error: set-photo-dates tool not found at $DATE_TOOL"
    exit 1
fi

# Set default scan directory
if [ -z "$scan_dir" ]; then
    scan_dir="$dest/scans"
fi

# Create directories
mkdir -p "$dest"
mkdir -p "$scan_dir"

# Generate filename with date prefix
timestamp=$(date +%s%3N)

# Determine date prefix
if [ -n "$date_input" ]; then
    # Parse the date input to create YYYY-MM-DD format
    if [[ "$date_input" =~ ^[0-9]{4}$ ]]; then
        # Year only (e.g., 1997)
        date_prefix="${date_input}-01-01"
    elif [[ "$date_input" =~ ^[0-9]{1,2}-[0-9]{4}$ ]]; then
        # Month-Year (e.g., 12-1997)
        month=$(printf "%02d" $(echo "$date_input" | cut -d'-' -f1))
        year=$(echo "$date_input" | cut -d'-' -f2)
        date_prefix="${year}-${month}-01"
    elif [[ "$date_input" =~ ^[0-9]{1,2}-[0-9]{1,2}-[0-9]{4}$ ]]; then
        # Month-Day-Year (e.g., 12-25-1997)
        month=$(printf "%02d" $(echo "$date_input" | cut -d'-' -f1))
        day=$(printf "%02d" $(echo "$date_input" | cut -d'-' -f2))
        year=$(echo "$date_input" | cut -d'-' -f3)
        date_prefix="${year}-${month}-${day}"
    else
        echo "Warning: Invalid date format. Using current date."
        date_prefix=$(date +%Y-%m-%d)
    fi
else
    # No date specified, use current date
    date_prefix=$(date +%Y-%m-%d)
fi

if [ -n "$name" ]; then
    clean_name=$(clean_filename "$name")
    scan_filename="${date_prefix}-${timestamp}-${clean_name}.jpg"
else
    scan_filename="${date_prefix}-${timestamp}.jpg"
fi

scan_path="$scan_dir/$scan_filename"

echo "multicrop-tool/scan starting..."
echo "Scanner device: $device"
echo "Scan file: $scan_path"
echo "Output directory: $dest"
echo ""

# Perform the scan
echo "🖨️  Scanning image..."
if scanimage -d "$device" --format jpeg -o "$scan_path"; then
    echo "✓ Scan completed: $scan_filename"
else
    echo "✗ Scan failed"
    exit 1
fi

echo ""

# Build process command
process_cmd="\"$PROCESS_TOOL\" -src \"$scan_path\" -dest \"$dest\""

if [ -n "$background_shortcut" ]; then
    process_cmd="$process_cmd -r $background_shortcut"
elif [ -n "$reference_image" ]; then
    process_cmd="$process_cmd -R \"$reference_image\""
elif [ -n "$background_color" ]; then
    process_cmd="$process_cmd -b $background_color"
fi

if [ "$save_mask" = true ]; then
    process_cmd="$process_cmd -M"
fi

if [ "$save_original" = true ]; then
    process_cmd="$process_cmd -O"
fi

if [ -n "$fuzz" ]; then
    process_cmd="$process_cmd -f $fuzz"
fi

if [ -n "$trim" ]; then
    process_cmd="$process_cmd -T $trim"
fi

echo "🔄 Processing scanned image..."
echo "Command: $process_cmd"
echo ""

# Execute processing
if eval $process_cmd; then
    echo ""
    echo "✓ Processing completed successfully"
    
    # Set dates on output files if specified
    if [ -n "$date_input" ]; then
        echo ""
        echo "📅 Setting photo dates..."
        
        # Find all output files (crops, originals, masks)
        output_files=()
        if [ -n "$name" ]; then
            clean_name=$(clean_filename "$name")
            pattern="$dest/${date_prefix}-${timestamp}-${clean_name}"
        else
            pattern="$dest/${date_prefix}-${timestamp}"
        fi
        
        # Add all matching files to array
        for file in "$pattern"*.jpg; do
            if [ -f "$file" ]; then
                output_files+=("$file")
            fi
        done
        
        if [ ${#output_files[@]} -gt 0 ]; then
            if "$DATE_TOOL" -date "$date_input" "${output_files[@]}"; then
                echo "✓ Photo dates set successfully"
            else
                echo "⚠️  Warning: Failed to set some photo dates"
            fi
        else
            echo "⚠️  Warning: No output files found to set dates on"
        fi
    fi
    
    # Clean up scan file if not keeping it
    if [ "$keep_scan" = false ]; then
        rm "$scan_path"
        echo "✓ Cleaned up original scan file"
    else
        echo "✓ Original scan saved at: $scan_path"
    fi
else
    echo ""
    echo "✗ Processing failed"
    echo "Original scan saved at: $scan_path"
    exit 1
fi

echo ""
echo "🎉 Scan and process complete!"
echo "Check output directory: $dest"