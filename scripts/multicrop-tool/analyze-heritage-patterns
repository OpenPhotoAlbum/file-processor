#!/bin/bash

# analyze-heritage-patterns - Discover patterns in heritage photo filenames
# 
# Usage: analyze-heritage-patterns [options] -dir <directory>
#
# Options:
#   -dir <directory>    Directory to analyze (recursive)
#   -min-count <n>     Minimum frequency to show (default: 3)
#   -output <file>     Save analysis to file
#   -help             Show this help

# Default values
target_dir=""
min_count=3
output_file=""

# Function to show help
show_help() {
    echo "analyze-heritage-patterns - Discover patterns in heritage photo filenames"
    echo ""
    echo "Usage: $0 [options] -dir <directory>"
    echo ""
    echo "Options:"
    echo "  -dir <directory>    Directory to analyze (recursive)"
    echo "  -min-count <n>     Minimum frequency to show (default: 3)"
    echo "  -output <file>     Save analysis to file"
    echo "  -help             Show this help"
    echo ""
    echo "Analyzes heritage photo filenames to discover:"
    echo "  - Common event patterns (disney, christmas, wedding)"
    echo "  - People names (stevie, jodis, didi)"
    echo "  - Location patterns (lancaster, disney, hollywood)"
    echo "  - Date clustering and frequency"
    echo ""
    echo "Examples:"
    echo "  $0 -dir /photos/staging/ready"
    echo "  $0 -dir /photos/staging/ready -min-count 5"
    echo "  $0 -dir /photos/staging/ready -output analysis.txt"
    echo ""
}

# Function to analyze patterns
analyze_patterns() {
    local dir="$1"
    local temp_dir=$(mktemp -d)
    
    echo "🔍 Analyzing heritage photo patterns in: $dir"
    echo "📊 Minimum frequency threshold: $min_count"
    echo ""
    
    # Get all JPG filenames
    find "$dir" -name "*.jpg" -o -name "*.jpeg" | \
        sed 's/.*\///' > "$temp_dir/all_files.txt"
    
    local total_files=$(wc -l < "$temp_dir/all_files.txt")
    echo "📂 Total heritage photos found: $total_files"
    echo ""
    
    # Remove extensions and timestamps for pattern analysis
    cat "$temp_dir/all_files.txt" | \
        sed 's/\.[^.]*$//' | \
        sed 's/^[0-9]\{13\}-//g' | \
        sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-//g' > "$temp_dir/cleaned_names.txt"
    
    echo "🎭 === EVENT & OCCASION PATTERNS ==="
    echo "Most common event keywords in filenames:"
    cat "$temp_dir/cleaned_names.txt" | \
        tr '-' '\n' | \
        tr '_' '\n' | \
        tr '[:upper:]' '[:lower:]' | \
        grep -E '^(disney|christmas|xmas|wedding|graduation|birthday|vacation|trip|holiday|easter|halloween|school|camp|party|dance|game|sports|baseball|football|beach|lake|park|zoo|museum|concert|show|festival|fair|carnival)' | \
        sort | uniq -c | sort -nr | \
        awk -v min="$min_count" '$1 >= min {printf "  %-3d %s\n", $1, $2}'
    echo ""
    
    echo "👨‍👩‍👧‍👦 === PEOPLE PATTERNS ==="
    echo "Most common names in filenames:"
    cat "$temp_dir/cleaned_names.txt" | \
        tr '-' '\n' | \
        tr '_' '\n' | \
        tr '[:upper:]' '[:lower:]' | \
        grep -E '^(stevie|stephen|steve|jodi|jodis|didi|jimmy|jim|patricia|pat|patty|eddie|edward|erica|david|kristy|travis|caleb|emily|tony|julie|beth|dorothy|danny|brian|brandon|shirley|lena|zachary|mom|dad|grandma|grandpa|nana|papa)' | \
        sort | uniq -c | sort -nr | \
        awk -v min="$min_count" '$1 >= min {printf "  %-3d %s\n", $1, $2}'
    echo ""
    
    echo "📍 === LOCATION PATTERNS ==="
    echo "Most common places in filenames:"
    cat "$temp_dir/cleaned_names.txt" | \
        tr '-' '\n' | \
        tr '_' '\n' | \
        tr '[:upper:]' '[:lower:]' | \
        grep -E '^(disney|epcot|universal|hollywood|magic|mountain|lancaster|lawrence|haverhill|boston|florida|california|maine|hampshire|vermont|beach|lake|park|zoo|museum|hospital|school|church|home|house)' | \
        sort | uniq -c | sort -nr | \
        awk -v min="$min_count" '$1 >= min {printf "  %-3d %s\n", $1, $2}'
    echo ""
    
    echo "📅 === DATE CLUSTERING ==="
    echo "Photos by year:"
    cat "$temp_dir/all_files.txt" | \
        grep -oE '(19[0-9]{2}|20[0-9]{2})' | \
        sort | uniq -c | sort -nr | \
        awk -v min="$min_count" '$1 >= min {printf "  %-3d %s\n", $1, $2}'
    echo ""
    
    echo "Photos by decade:"
    cat "$temp_dir/all_files.txt" | \
        grep -oE '(19[0-9]{2}|20[0-9]{2})' | \
        sed 's/\(..\).$/\10s/' | \
        sort | uniq -c | sort -nr | \
        awk '{printf "  %-3d %s\n", $1, $2}'
    echo ""
    
    echo "🏷️  === POTENTIAL COLLECTIONS (10+ photos) ==="
    echo "Event-based collections that would be created:"
    
    # Look for groups that would make collections
    cat "$temp_dir/cleaned_names.txt" | \
        tr '-' '\n' | \
        tr '_' '\n' | \
        tr '[:upper:]' '[:lower:]' | \
        grep -E '^(disney|christmas|xmas|wedding|graduation|birthday|vacation|trip|holiday|easter|halloween)' | \
        sort | uniq -c | sort -nr | \
        awk '$1 >= 10 {printf "  📁 %s (%d photos)\n", $2, $1}'
    
    echo ""
    echo "Year-based collections that would be created:"
    cat "$temp_dir/all_files.txt" | \
        grep -oE '(19[0-9]{2}|20[0-9]{2})' | \
        sort | uniq -c | sort -nr | \
        awk '$1 >= 10 {printf "  📁 %s (%d photos)\n", $2, $1}'
    
    echo ""
    echo "🔧 === FILENAME STRUCTURE ANALYSIS ==="
    echo "Common filename patterns:"
    cat "$temp_dir/all_files.txt" | \
        sed 's/[0-9]/N/g' | \
        sed 's/\.[^.]*$//' | \
        sort | uniq -c | sort -nr | head -10 | \
        awk '{printf "  %-3d %s\n", $1, $2}'
    
    # Cleanup
    rm -rf "$temp_dir"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -dir)
            target_dir="$2"
            shift 2
            ;;
        -min-count)
            min_count="$2"
            shift 2
            ;;
        -output)
            output_file="$2"
            shift 2
            ;;
        -help|--help|-h)
            show_help
            exit 0
            ;;
        -*)
            echo "Error: Unknown option $1"
            echo "Use -help for usage information"
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument $1"
            echo "Use -help for usage information"
            exit 1
            ;;
    esac
done

# Validate arguments
if [[ -z "$target_dir" ]]; then
    echo "Error: Must specify -dir <directory>"
    echo "Use -help for usage information"
    exit 1
fi

if [[ ! -d "$target_dir" ]]; then
    echo "Error: Directory does not exist: $target_dir"
    exit 1
fi

# Run analysis
if [[ -n "$output_file" ]]; then
    echo "📝 Saving analysis to: $output_file"
    analyze_patterns "$target_dir" | tee "$output_file"
else
    analyze_patterns "$target_dir"
fi

echo ""
echo "✅ Heritage pattern analysis complete!"
echo ""
echo "💡 Use this data to configure collection detection patterns"
echo "   and family name extraction for the heritage processor."